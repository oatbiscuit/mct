readonly VERSION='0.1.0'
readonly SECONDS_PER_DAY=86400

readonly XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly MCT_DIR="${XDG_DATA_HOME}/mct"
readonly CYCLES_FILE="${MCT_DIR}/cycles"

if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
    readonly C_YELLOW='\033[1;33m'
    readonly C_BLUE='\033[1;34m'
    readonly C_RED='\033[1;31m'
    readonly C_RESET='\033[m'
else
    readonly C_YELLOW=''
    readonly C_BLUE=''
    readonly C_RED=''
    readonly C_RESET=''
fi

log() {
    printf '%b%s %b%s%b %s\n' \
        "$C_YELLOW" "${3:-->}" "${C_BLUE}" "$1" "$C_RESET" "$2" >&2
}
warn() {
    log "$1" "$2" "${3:-WARNING}"
}
die() {
    printf '%bERROR%b %s\n' "${C_RED}" "${C_RESET}" "$1" >&2
    exit 1
}

setup() {
    mkdir -p "$MCT_DIR" 2>/dev/null || {
        die 'cannot create %s' "$MCT_DIR"
    }
    chmod 700 "$MCT_DIR"

    touch "$CYCLES_FILE" 2>/dev/null || {
        die 'cannot create %s' "$CYCLES_FILE"
    }
    chmod 600 "$CYCLES_FILE"
}

date_to_epoch() {
    awk -v d="$1" 'BEGIN {
        split(d, a, "-");
        seconds = mktime(a[1] " " a[2] " " a[3] " 0 0 0");
        print seconds;
        exit;
    }'
}

date_add_days() {
    awk -v d="$1" -v n="$2" 'BEGIN {
        split(d, a, "-");
        seconds = mktime(a[1] " " a[2] " " a[3] " 0 0 0") + n * '"$SECONDS_PER_DAY"';
        print strftime("%Y-%m-%d", seconds);
        exit;
    }'
}

validate_date() {
    date_str="$1"

    if ! echo "$date_str" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        die 'invalid date format. use YYYY-MM-DD'
    fi

    if ! echo "$date_str" | awk -F- '{
        year = $1 + 0;
        month = $2 + 0;
        day = $3 + 0;

        if (month < 1 || month > 12) exit 1;

        if (month == 2) {
            if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0))
                max_days = 29;
            else
                max_days = 28;
        } else if (month == 4 || month == 6 || month == 9 || month == 11) {
            max_days = 30;
        } else {
            max_days = 31
        }
        if (day < 1 || day > max_days) exit 1;
        exit 0;
    }' 2>/dev/null; then
        die "invalid date: ${date_str} (use YYYY-MM-DD)"
    fi

    return 0
}

_temp_files=""
create_temp_file() {
    tmpfile=$(mktemp 2>/dev/null) || tmpfile="/tmp/mct.$$"
    _temp_files="$_temp_files $tmpfile"
    trap 'rm -f $_temp_files' EXIT INT TERM HUP
    printf '%s' "$tmpfile"
}

record() {
    setup || return 1
    date_str="${1:-$(date +%Y-%m-%d)}"
    validate_date "$date_str" || return 1

    if grep -qxF "$date_str" "$CYCLES_FILE" 2>/dev/null; then
        warn "already recorded for ${date_str}"
        return 1
    fi

    echo "$date_str" >> "$CYCLES_FILE"
    sort -u -o "$CYCLES_FILE" "$CYCLES_FILE"
    log "recorded cycle for ${date_str}"
}

delete() {
    setup || return 1
    date_str="${1:-$(date +%Y-%m-%d)}"
    validate_date "$date_str" || return 1

    if ! grep -qxF "$date_str" "$CYCLES_FILE" 2>/dev/null; then
        die "no record for ${date_str}"
    fi

    tmpfile=$(create_temp_file)

    grep -vxF "$date_str" "$CYCLES_FILE" > "$tmpfile" 2>/dev/null || :
    mv "$tmpfile" "$CYCLES_FILE"
    log "deleted cycle for ${date_str}"
}

# Helper: Parse cycles from the cycles file
# Output: cycle_start|cycle_end|cycle_days|gap_to_next
find_cycles() {
    [ -s "$CYCLES_FILE" ] || return 1

    prev_date=""
    current_start=""
    current_end=""
    cycle_days=0
    gap=0

    while read -r date_str; do
        [ -z "$date_str" ] && continue

        if [ -z "$prev_date" ]; then
            current_start="$date_str"
            cycle_days=1
        else
            prev_epoch=$(date_to_epoch "$prev_date")
            curr_epoch=$(date_to_epoch "$date_str")
            diff=$(( (curr_epoch - prev_epoch) / SECONDS_PER_DAY ))

            if [ "$diff" -eq 1 ]; then
                cycle_days=$(( cycle_days + 1 ))
            else
                current_end="$prev_date"
                gap=$((diff - 1))
                printf '%s|%s|%s|%s\n' "$current_start" "$current_end" "$cycle_days" "$gap"
                current_start="$date_str"
                cycle_days=1
            fi
        fi
        prev_date="$date_str"
    done < "$CYCLES_FILE"

    # last cycle
    current_end="$prev_date"
    printf '%s|%s|%s|0\n' "$current_start" "$current_end" "$cycle_days"
}

predict() {
    [ -s "$CYCLES_FILE" ] || {
        warn 'no cycles recorded yet'
        return 0
    }

    sum_gaps=0
    gap_count=0
    sum_days=0
    cycle_count=0
    last_start=""
    last_end=""
    last_days=0

    tmpfile=$(create_temp_file) 

    find_cycles > "$tmpfile" || {
        rm -f "$tmpfile"
        die 'no cycle data available'
    }

    while IFS='|' read -r start end days gap; do
        last_start="$start"
        last_end="$end"
        last_days="$days"

        if [ "$gap" -gt 0 ]; then
            sum_gaps=$(( sum_gaps + gap ))
            gap_count=$(( gap_count + 1 ))
        fi

        sum_days=$(( sum_days + days ))
        cycle_count=$(( cycle_count + 1 ))
    done < "$tmpfile"

    rm -f "$tmpfile"

    [ "$gap_count" -gt 0 ] || {
        die 'need at least 2 cycles to predict'
    }

    avg_gap=$(( sum_gaps / gap_count ))
    next_start=$(date_add_days "$last_end" $((avg_gap + 1)))
    avg_cycle_days=$(( sum_days / cycle_count ))
    next_end=$(date_add_days "$next_start" $((avg_cycle_days - 1)))
    days_until=$(( ($(date_to_epoch "$next_start") - $(date_to_epoch "$(date +%Y-%m-%d)")) / SECONDS_PER_DAY ))
    [ "$days_until" -lt 0 ] && days_until=0

    log 'CYCLE PREDICTION'
    log "   last cycle:         ${last_start} -> ${last_end} (${last_days} days)" 
    log "   avg length:         ${avg_gap} days (${gap_count} cycles)"
    log "   avg duration:       ${avg_cycle_days} days"
    log ''
    log 'NEXT CYCLE'
    log "   start:              ${next_start}"
    log "   end:                ${next_end}"
    log "   duration:           ${avg_cycle_days} days"
    log "   days until:         ${days_until} days"
}

stats() {
    [ -s "$CYCLES_FILE" ] || {
        warn 'no cycles recorded yet.'
        return 0
    }

    total_days=$(wc -l < "$CYCLES_FILE")
    first_day=$(head -n1 "$CYCLES_FILE")
    last_day=$(tail -n1 "$CYCLES_FILE")

    cycle_count=0
    sum_cycle_days=0
    sum_gaps=0
    gap_count=0
    min_gap=""
    max_gap=""

    tmpfile=$(create_temp_file)

    find_cycles > "$tmpfile" || {
        rm -f "$tmpfile"
        die 'no cycle data available'
    }
    while IFS='|' read -r _ _ days gap; do
        cycle_count=$(( cycle_count + 1 ))
        sum_cycle_days=$(( sum_cycle_days + days ))

        if [ "$gap" -gt 0 ]; then
            sum_gaps=$(( sum_gaps + gap ))
            gap_count=$(( gap_count + 1 ))
            if [ -z "$min_gap" ] || [ "$gap" -lt "$min_gap" ]; then
                min_gap="$gap"
            fi
            if [ -z "$max_gap" ] || [ "$gap" -gt "$max_gap" ]; then
                max_gap="$gap"
            fi
        fi

    done < "$tmpfile"

    rm -f "$tmpfile"

    log 'CYCLE STATISTICS'
    log "   total days:         ${total_days}"
    log "   total cycles:       ${cycle_count}"
    log "   first recorded:     ${first_day}"
    log "   last recorded:      ${last_day}"

    [ "$cycle_count" -gt 0 ] && {
        avg_cycle_days=$(( sum_cycle_days / cycle_count ))
        log "   avg duration:       ${avg_cycle_days} days"
    }

    [ "$gap_count" -gt 0 ] && {
        avg_gap=$(( sum_gaps / gap_count ))
        log "   avg length:         ${avg_gap} days (${gap_count} cycles)"
        if [ -n "$min_gap" ] && [ -n "$max_gap" ]; then
            log "   range:              ${min_gap} - ${max_gap} days"
        fi
    } 
}

main() {
    case "$1" in
        -h|--help)
            cat <<EOF
Usage: mct [OPTION] [COMMAND] [DATE]

DATE format: YYYY-MM-DD (e.g., 2026-09-01)

Commands:
    r, record   [DATE]      Record a cycle day (default: today)
    d, delete   [DATE]      Delete a cycle day (default: today)
    p, predict              Predict next start date.
    s, stats                Show current stats.

Options:
    -h, --help              Show this help message.
    -v, --version           Show version information
EOF
            exit 0
        ;;

        -v|--version)
            printf "mct %s\n" "$VERSION"
            exit 0
        ;;

        r|record)
            shift
            record "$@"
        ;;

        d|delete)
            shift
            delete "$@"
        ;;

        p|predict)
            predict
        ;;

        s|stats)
            stats
        ;;

        *)
            if [ -n "$1" ]; then 
                printf 'error: unknown command: %s\n' "$1" >&2
            fi
            printf "try 'mct --help' for usage.\n" >&2
            exit 1
        ;;
    esac
}

main "$@"
