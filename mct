VERSION='0.1.0'

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
MCT_DIR="${XDG_DATA_HOME}/mct"
CYCLES_FILE="${MCT_DIR}/cycles"

setup() {
    mkdir -p "$MCT_DIR" 2>/dev/null || {
        printf 'error: cannot create %s\n' "$MCT_DIR" >&2
        exit 1
    }
    chmod 700 "$MCT_DIR"

    touch "$CYCLES_FILE" 2>/dev/null || {
        printf 'error: cannot create %s\n' "$CYCLES_FILE" >&2
        exit 1
    }
    chmod 600 "$CYCLES_FILE"
}

validate_date() {
    date_str="$1"

    if ! echo "$date_str" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        printf 'error: invalid date format. use YYYY-MM-DD\n' >&2
        return 1
    fi

    command -v date >/dev/null 2>&1 || return 0

    date -d "$date_str" >/dev/null 2>&1 || {
        printf 'error: invalid date: %s\n' "$date_str" >&2
        return 1
    } 

    return 0
}

record() {
    setup || return 1
    date_str="${1:-$(date +%Y-%m-%d)}"
    validate_date "$date_str" || return 1

    if grep -qxF "$date_str" "$CYCLES_FILE" 2>/dev/null; then
        printf 'already recorded for %s\n' "$date_str" >&2
        return 1
    fi

    echo "$date_str" >> "$CYCLES_FILE"
    sort -u -o "$CYCLES_FILE" "$CYCLES_FILE"
    printf 'recorded cycle for %s\n' "$date_str" >&2
}

delete() {
    setup || return 1
    date_str="${1:-$(date +%Y-%m-%d)}"
    validate_date "$date_str" || return 1

    if ! grep -qxF "$date_str" "$CYCLES_FILE" 2>/dev/null; then
        printf 'error: no record for %s\n' "$date_str" >&2
        return 1
    fi

    TMP_FILE=$(mktemp) || {
        printf 'error: cannot create temp file\n' >&2
        return 1
    }

    grep -vxF "$date_str" "$CYCLES_FILE" > "$TMP_FILE"
    mv "$TMP_FILE" "$CYCLES_FILE"
    printf 'deleted cycle for %s\n' "$date_str" >&2
}

# Helper: Parse cycles from the cycles file
# Output: cycle_start|cycle_end|cycle_days|gap_to_next
find_cycles() {
    [ -s "$CYCLES_FILE" ] || return 1

    prev_date=""
    current_start=""
    current_end=""
    cycle_days=0
    gap=0

    while read -r date_str; do
        if [ -z "$prev_date" ]; then
            current_start="$date_str"
            cycle_days=1
        else
            prev_epoch=$(date -d "$prev_date" +%s)
            curr_epoch=$(date -d "$date_str" +%s)
            diff=$(( (curr_epoch - prev_epoch) / 86400 ))

            if [ "$diff" -eq 1 ]; then
                cycle_days=$(( cycle_days + 1 ))
            else
                current_end="$prev_date"
                gap=$((diff - 1))
                printf '%s|%s|%s|%s\n' "$current_start" "$current_end" "$cycle_days" "$gap"
                current_start="$date_str"
                cycle_days=1
            fi
        fi
        prev_date="$date_str"
    done < "$CYCLES_FILE"

    # last cycle
    current_end="$prev_date"
    printf '%s|%s|%s|0\n' "$current_start" "$current_end" "$cycle_days"
}

stats() {
    setup || return 1

    [ -s "$CYCLES_FILE" ] || {
        printf 'no cycles recorded yet.\n' >&2
        return 0
    }

    total_days=$(wc -l < "$CYCLES_FILE")
    first_day=$(head -n1 "$CYCLES_FILE")
    last_day=$(tail -n1 "$CYCLES_FILE")

    cycle_count=0
    sum_cycle_days=0
    sum_gaps=0
    gap_count=0
    min_gap=""
    max_gap=""

    cycles_data=$(find_cycles) || {
        printf 'error: failed to retrieve cycle data\n' >&2
        return 1
    }

    while IFS='|' read -r _ _ days gap; do
        cycle_count=$(( cycle_count + 1 ))
        sum_cycle_days=$(( sum_cycle_days + days ))

        if [ "$gap" -gt 0 ]; then
            sum_gaps=$(( sum_gaps + gap ))
            gap_count=$(( gap_count + 1 ))
            [ -z "$min_gap" ] || [ "$gap" -lt "$min_gap" ] && min_gap="$gap"
            [ -z "$max_gap" ] || [ "$gap" -gt "$max_gap" ] && max_gap="$gap"
        fi

   done <<EOF 
$cycles_data
EOF

    printf 'total days recorded: %s\n' "$total_days" >&2
    printf 'total cycles: %s\n' "$cycle_count" >&2
    printf 'first recorded: %s\n' "$first_day" >&2
    printf 'last recorded: %s\n' "$last_day" >&2

    [ "$cycle_count" -gt 0 ] && {
        avg_cycle_days=$(( sum_cycle_days / cycle_count ))
        printf 'average cycle length: %s days\n' "$avg_cycle_days" >&2
    }

    [ "$gap_count" -gt 0 ] && {
        avg_gap=$(( sum_gaps / gap_count ))
        printf 'average days between cycles: %s days\n' "$avg_gap" >&2
        [ -n "$min_gap" ] && [ -n "$max_gap" ] && \
            printf 'cycle range: %s-%s days\n' "$min_gap" "$max_gap" >&2
    } 
}

main() {
    case "$1" in
        -h|--help)
            cat <<EOF
Usage: mct [OPTION] [COMMAND] [DATE]

Commands:
    r, record   [DATE]      Record a cycle day (default: today)
    d, delete   [DATE]      Delete a cycle day (default: today)
    p, predict              Predict next start date.
    s, stats                Show current stats.

Options:
    -h, --help              Show this help message.
    -v, --version           Show version information
EOF
            exit 0
        ;;

        -v|--version)
            printf "mct %s\n" "$VERSION" >&2
            exit 0
        ;;

        r|record)
            shift
            record "$@"
        ;;

        d|delete)
            shift
            delete "$@"
        ;;

        s|stats)
            stats
        ;;

        *)
            if [ -n "$1" ]; then 
                printf 'error: unknown command: %s\n' "$1" >&2
            fi
            printf "try 'mct --help' for usage.\n" >&2
            exit 1
        ;;
    esac
}

main "$@"
