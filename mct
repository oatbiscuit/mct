VERSION='0.1.0'

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
MCT_DIR="${XDG_DATA_HOME}/mct"
CYCLES_FILE="${MCT_DIR}/cycles"

setup() {
    mkdir -p "$MCT_DIR" 2>/dev/null || {
        printf 'error: cannot create %s\n' "$MCT_DIR" >&2
        exit 1
    }
    chmod 700 "$MCT_DIR"

    touch "$CYCLES_FILE" 2>/dev/null || {
        printf 'error: cannot create %s\n' "$CYCLES_FILE" >&2
        exit 1
    }
    chmod 600 "$CYCLES_FILE"
}

date_to_epoch() {
    awk -v d="$1" 'BEGIN {
        split(d, a, "-");
        seconds = mktime(a[1] " " a[2] " " a[3] " 0 0 0");
        print seconds;
        exit;
    }'
}

date_add_days() {
    awk -v d="$1" -v n="$2" 'BEGIN {
        split(d, a, "-");
        seconds = mktime(a[1] " " a[2] " " a[3] " 0 0 0") + n * 86400;
        print strftime("%Y-%m-%d", seconds);
        exit;
    }'
}

validate_date() {
    date_str="$1"

    if ! echo "$date_str" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        printf 'error: invalid date format. use YYYY-MM-DD\n' >&2
        return 1
    fi

    if ! echo "$date_str" | awk -F- '{
        year = $1 + 0;
        month = $2 + 0;
        day = $3 + 0;

        if (month < 1 || month > 12) exit 1;

        if (month == 2) {
            if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0))
                max_days = 29;
            else
                max_days = 28;
        } else if (month == 4 || month == 6 || month == 9 || month == 11) {
            max_days = 30;
        } else {
            max_days = 31
        }
        if (day < 1 || day > max_days) exit 1;
        exit 0;
    }' 2>/dev/null; then
        printf 'error: invalid date: %s (use YYYY-MM-DD)\n' "$date_str" >&2
        return 1
    fi

    return 0
}

create_temp_file() {
    tmpfile=$(mktemp 2>/dev/null) || tmpfile="/tmp/mct.$$"
    trap 'rm -f "$tmpfile"' EXIT INT TERM HUP
    printf '%s' "$tmpfile"
}

record() {
    setup || return 1
    date_str="${1:-$(date +%Y-%m-%d)}"
    validate_date "$date_str" || return 1

    if grep -qxF "$date_str" "$CYCLES_FILE" 2>/dev/null; then
        printf 'already recorded for %s\n' "$date_str" >&2
        return 1
    fi

    echo "$date_str" >> "$CYCLES_FILE"
    sort -u -o "$CYCLES_FILE" "$CYCLES_FILE"
    printf 'recorded cycle for %s\n' "$date_str" >&2
}

delete() {
    setup || return 1
    date_str="${1:-$(date +%Y-%m-%d)}"
    validate_date "$date_str" || return 1

    if ! grep -qxF "$date_str" "$CYCLES_FILE" 2>/dev/null; then
        printf 'error: no record for %s\n' "$date_str" >&2
        return 1
    fi

    tmpfile=$(create_temp_file)

    grep -vxF "$date_str" "$CYCLES_FILE" > "$tmpfile" || {
        printf 'error: failed to create temp file\n' >&2
        rm -f "$tmpfile"
        return 1 
    }
    mv "$tmpfile" "$CYCLES_FILE"
    printf 'deleted cycle for %s\n' "$date_str" >&2
}

# Helper: Parse cycles from the cycles file
# Output: cycle_start|cycle_end|cycle_days|gap_to_next
find_cycles() {
    [ -s "$CYCLES_FILE" ] || return 1

    prev_date=""
    current_start=""
    current_end=""
    cycle_days=0
    gap=0

    while read -r date_str; do
        [ -z "$date_str" ] && continue

        if [ -z "$prev_date" ]; then
            current_start="$date_str"
            cycle_days=1
        else
            prev_epoch=$(date_to_epoch "$prev_date")
            curr_epoch=$(date_to_epoch "$date_str")
            diff=$(( (curr_epoch - prev_epoch) / 86400 ))

            if [ "$diff" -eq 1 ]; then
                cycle_days=$(( cycle_days + 1 ))
            else
                current_end="$prev_date"
                gap=$((diff - 1))
                printf '%s|%s|%s|%s\n' "$current_start" "$current_end" "$cycle_days" "$gap"
                current_start="$date_str"
                cycle_days=1
            fi
        fi
        prev_date="$date_str"
    done < "$CYCLES_FILE"

    # last cycle
    current_end="$prev_date"
    printf '%s|%s|%s|0\n' "$current_start" "$current_end" "$cycle_days"
}

predict() {
    [ -s "$CYCLES_FILE" ] || {
        printf 'no cycles recorded yet\n' >&2
        return 0
    }

    sum_gaps=0
    gap_count=0
    sum_days=0
    cycle_count=0
    last_start=""
    last_end=""
    last_days=0

    tmpfile=$(create_temp_file) 

    find_cycles > "$tmpfile" || {
        rm -f "$tmpfile"
        printf 'no cycle data available\n' >&2
        return 1
    }

    while IFS='|' read -r start end days gap; do
        last_start="$start"
        last_end="$end"
        last_days="$days"

        if [ "$gap" -gt 0 ]; then
            sum_gaps=$(( sum_gaps + gap ))
            gap_count=$(( gap_count + 1 ))
        fi

        sum_days=$(( sum_days + days ))
        cycle_count=$(( cycle_count + 1 ))
    done < "$tmpfile"

    rm -f "$tmpfile"

    [ "$gap_count" -gt 0 ] || {
        printf 'need at least 2 cycles to predict\n' >&2
        return 1
    }

    avg_gap=$(( sum_gaps / gap_count ))
    next_start=$(date_add_days "$last_end" $((avg_gap + 1)))
    avg_cycle_days=$(( sum_days / cycle_count ))
    next_end=$(date_add_days "$next_start" $((avg_cycle_days - 1)))

    printf 'last cycle: %s to %s (%s days)\n' "$last_start" "$last_end" "$last_days"
    printf 'average cycle length: %s days (based on %s cycles)\n' "$avg_gap" "$gap_count"
    printf 'average period duration: %s days\n' "$avg_cycle_days"
    printf '\n'
    printf 'predicted next cycle:\n'
    printf '  start: %s\n' "$next_start"
    printf '  end:   %s\n' "$next_end"
    printf '  duration: %s days\n' "$avg_cycle_days"
}

stats() {
    [ -s "$CYCLES_FILE" ] || {
        printf 'no cycles recorded yet.\n' >&2
        return 0
    }

    total_days=$(wc -l < "$CYCLES_FILE")
    first_day=$(head -n1 "$CYCLES_FILE")
    last_day=$(tail -n1 "$CYCLES_FILE")

    cycle_count=0
    sum_cycle_days=0
    sum_gaps=0
    gap_count=0
    min_gap=""
    max_gap=""

    tmpfile=$(create_temp_file)

    find_cycles > "$tmpfile" || {
        rm -f "$tmpfile"
        printf 'no cycle data available\n' >&2
        return 1
    }
    while IFS='|' read -r _ _ days gap; do
        cycle_count=$(( cycle_count + 1 ))
        sum_cycle_days=$(( sum_cycle_days + days ))

        if [ "$gap" -gt 0 ]; then
            sum_gaps=$(( sum_gaps + gap ))
            gap_count=$(( gap_count + 1 ))
            if [ -z "$min_gap" ] || [ "$gap" -lt "$min_gap" ]; then
                min_gap="$gap"
            fi
            if [ -z "$max_gap" ] || [ "$gap" -gt "$max_gap" ]; then
                max_gap="$gap"
            fi
        fi

    done < "$tmpfile"

    rm -f "$tmpfile"

    printf 'total days recorded: %s\n' "$total_days"
    printf 'total cycles: %s\n' "$cycle_count"
    printf 'first recorded: %s\n' "$first_day"
    printf 'last recorded: %s\n' "$last_day"

    [ "$cycle_count" -gt 0 ] && {
        avg_cycle_days=$(( sum_cycle_days / cycle_count ))
        printf 'average cycle length: %s days\n' "$avg_cycle_days"
    }

    [ "$gap_count" -gt 0 ] && {
        avg_gap=$(( sum_gaps / gap_count ))
        printf 'average days between cycles: %s days\n' "$avg_gap"
        [ -n "$min_gap" ] && [ -n "$max_gap" ] && \
            printf 'cycle range: %s-%s days\n' "$min_gap" "$max_gap"
    } 
}

main() {
    case "$1" in
        -h|--help)
            cat <<EOF
Usage: mct [OPTION] [COMMAND] [DATE]

Commands:
    r, record   [DATE]      Record a cycle day (default: today)
    d, delete   [DATE]      Delete a cycle day (default: today)
    p, predict              Predict next start date.
    s, stats                Show current stats.

Options:
    -h, --help              Show this help message.
    -v, --version           Show version information
EOF
            exit 0
        ;;

        -v|--version)
            printf "mct %s\n" "$VERSION"
            exit 0
        ;;

        r|record)
            shift
            record "$@"
        ;;

        d|delete)
            shift
            delete "$@"
        ;;

        p|predict)
            predict
        ;;

        s|stats)
            stats
        ;;

        *)
            if [ -n "$1" ]; then 
                printf 'error: unknown command: %s\n' "$1" >&2
            fi
            printf "try 'mct --help' for usage.\n" >&2
            exit 1
        ;;
    esac
}

main "$@"
